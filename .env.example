# ===================================================================
# Aggarly — Environment Variables
# ===================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will NOT be committed.
# ===================================================================

# ========================
# Database (PostgreSQL)
# ========================
DATABASE_URL=jdbc:postgresql://localhost:5432/aggarly_db
DATABASE_USERNAME=aggarly
DATABASE_PASSWORD=aggarly_secret

# ========================
# Redis
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aggarly_redis_secret

# ========================
# JWT
# ========================
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-256-bits-long-for-hs256

# ========================
# MinIO (S3-compatible storage)
# ========================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=aggarly_minio
MINIO_SECRET_KEY=aggarly_minio_secret
MINIO_BUCKET=aggarly-files

# ========================
# Stripe
# ========================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ========================
# Mail
# ========================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@aggarly.com

# ========================
# CORS
# ========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================
# Server
# ========================
SERVER_PORT=8080
